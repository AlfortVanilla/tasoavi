#include <winver.h>
#include <winuser.h>

1 RT_MANIFEST "tasopatch.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104B0"
        BEGIN
            VALUE "FileDescription",  "tasoavi.dll import patcher"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "tasopatch"
            VALUE "OriginalFilename", "tasopatch.exe"
            VALUE "ProductName",      "tasoavi AVIFile shim"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Rewrites one import DLL name in a 32-bit PE from AVIFIL32.dll to tasoavi.dll."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
